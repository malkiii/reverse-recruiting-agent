# Password for signing in to the dashboard
DASHBOARD_PASSWORD=

# Bearer token cron-job.org sends to POST /api/collection
CRON_SECRET=

# Supabase transaction pooler connection string, port 6543 (server-side only)
DATABASE_URL=

# Public URL of this app, used for Apify webhooks
APP_URL=

# Comma-separated Apify API tokens
APIFY_TOKENS=

# Shared secret that authenticates Apify webhooks
APIFY_WEBHOOK_SECRET=
